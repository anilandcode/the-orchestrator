# ---------------------------------------------------------------------------
# Provider credentials. Only needed for `pnpm smoke` and live API runs.
# The full test suite runs offline with no keys set.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter reaches several hundred models with a single key, free tier included. It is the
# cheapest path to validating anything in this repo against a real provider.
OPENROUTER_API_KEY=
# Optional attribution shown on OpenRouter's public leaderboards.
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=

# Which catalog models become CALLABLE, and therefore bandit arms. Comma-separated ids or patterns
# ("openai/*"). Empty means none.
#
# Empty by default on arithmetic, not caution. LinUCB regret grows with sqrt(arms x time), so opening
# all ~300 catalog models multiplies exploration cost roughly 7x against a headroom over static rules
# measured at 2.10%. Pick a handful that plausibly differ on your traffic; the catalog stays full of
# knowledge either way.
OPENROUTER_MODELS=

# ---------------------------------------------------------------------------
# Router mode. Defaults to `shadow`: the adaptive router computes and logs a
# decision on every request but the static router is what actually executes.
# Only move to `adaptive` once replay on real CallEvent data justifies it.
#   static   - static rules only, no bandit
#   shadow   - static executes, adaptive logged alongside for comparison
#   adaptive - bandit executes
# ---------------------------------------------------------------------------
ROUTER_MODE=shadow

# Exploration constant for LinUCB. Higher = more exploration.
ROUTER_LINUCB_ALPHA=0.6
# Minimum observations per arm before the bandit is trusted over static rules.
ROUTER_COLD_START_PULLS=25

# ---------------------------------------------------------------------------
# Storage. SQLite today; swapping to Postgres is a repository-driver change.
# ---------------------------------------------------------------------------
ORCHESTRATOR_DB_PATH=./data/orchestrator.sqlite

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3000
# Single static key for the pre-multi-tenant stage. Phase 8 replaces this.
ORCHESTRATOR_API_KEY=local-dev-key
DEFAULT_TENANT_ID=local

# ---------------------------------------------------------------------------
# Model catalog and benchmark priors.
#
# `pnpm catalog:refresh` ingests the public OpenRouter catalog (no auth needed) for pricing and
# context windows, and merges the curated benchmark file. Nothing is applied until you re-run with
# --apply, because ingested pricing feeds cost accounting, the reward's cost term, and budget
# filtering.
#
# CATALOG_PRIORS_ENABLED is off on evidence, not caution. Simulation showed prior seeding works when
# the priors are true (27% less early regret from ground-truth priors) but that seeding from the
# shipped placeholder benchmark numbers made routing WORSE. Replace those numbers with figures you
# have validated against your own traffic before turning this on.
# ---------------------------------------------------------------------------
CATALOG_PRIORS_ENABLED=false
